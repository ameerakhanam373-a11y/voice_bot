# Groq API default. Create a key at https://console.groq.com/keys.
# You may instead use LM Studio (http://localhost:1234/v1, key lm-studio)
# or Ollama (http://localhost:11434/v1, key ollama).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# Local retrieval
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=full_stack_academy_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local voice components
WHISPER_MODEL=base
TTS_ENGINE=pyttsx3
TTS_VOICE=default
PIPER_EXECUTABLE=piper

# Optional LiveKit transport (not needed for local demo)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_STT_BASE_URL=
LIVEKIT_STT_MODEL=whisper-1
LIVEKIT_TTS_BASE_URL=
LIVEKIT_TTS_MODEL=tts-1
